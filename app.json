{
  "expo": {
    "name": "홍그와트",
    "slug": "Frontend",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.honggwart",
      "appleTeamId": "9K8JHKDYV3",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSLocationWhenInUseUsageDescription": "홍그와트는 현재 위치를 사용하지 않습니다. 지도 기능에 포함된 항목이며, 위치 정보를 수집하거나 저장하지 않습니다.",
        "NSAppTransportSecurity": {
          "NSExceptionDomains": {
            "map.naver.com": {
              "NSExceptionAllowsInsecureHTTPLoads": true,
              "NSIncludesSubdomains": true
            },
            "map.naver.net": {
              "NSExceptionAllowsInsecureHTTPLoads": true,
              "NSIncludesSubdomains": true
            }
          }
        }
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.honggwart",
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ]
    },
    "plugins": [
      [
        "@mj-studio/react-native-naver-map",
        {
          "client_id": "41u83ejd91",
          "ios": {
            "NSLocationWhenInUseUsageDescription": "홍그와트는 현재 위치를 사용하지 않습니다. 지도 기능에 포함된 항목이며, 위치 정보를 수집하거나 저장하지 않습니다."
          }
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "extraMavenRepos": [
              "https://repository.map.naver.com/archive/maven"
            ]
          }
        }
      ],
      "expo-status-bar",
      "expo-font",
      "expo-splash-screen",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "음성으로 검색하려면 마이크 접근 권한이 필요합니다.",
          "speechRecognitionPermission": "음성을 텍스트로 변환하려면 음성 인식 권한이 필요합니다."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "3b0e17ac-29ff-4460-ac80-67bfae308521"
      }
    },
    "owner": "honggwart",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/3b0e17ac-29ff-4460-ac80-67bfae308521"
    }
  }
}
