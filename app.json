{
  "expo": {
    "name": "홍그와트",
    "slug": "Frontend",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.honggwart",
      "appleTeamId": "9K8JHKDYV3",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSLocationWhenInUseUsageDescription": "지도 표시 기능에 위치 정보가 사용될 수 있습니다. 이 앱은 현재 위치를 수집하지 않습니다.",
        "NSAppTransportSecurity": {
          "NSExceptionDomains": {
            "map.naver.com": {
              "NSExceptionAllowsInsecureHTTPLoads": true,
              "NSIncludesSubdomains": true
            },
            "map.naver.net": {
              "NSExceptionAllowsInsecureHTTPLoads": true,
              "NSIncludesSubdomains": true
            }
          }
        }
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.honggwart.frontend"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "@mj-studio/react-native-naver-map",
        {
          "client_id": "41u83ejd91",
          "ios": {
            "NSLocationWhenInUseUsageDescription": "지도 표시 기능에 위치 정보가 사용될 수 있습니다. 이 앱은 현재 위치를 수집하지 않습니다."
          }
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "extraMavenRepos": [
              "https://repository.map.naver.com/archive/maven"
            ]
          }
        }
      ],
      "expo-status-bar",
      "expo-font",
      "expo-splash-screen",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "음성으로 검색하려면 마이크 접근 권한이 필요합니다.",
          "speechRecognitionPermission": "음성을 텍스트로 변환하려면 음성 인식 권한이 필요합니다."
        }
      ]
    ]
  }
}
